# ── Deployer key (no 0x prefix) ───────────────────────────────────────────────
# This wallet pays gas. Receives no roles — roles come from ADMIN_ADDRESS and MINTER_ADDRESS.
# Use a hardware wallet or KMS in production.
PRIVATE_KEY=your_deployer_private_key_here

# ── Role addresses ─────────────────────────────────────────────────────────────
# The deploy script grants DEFAULT_ADMIN_ROLE to ADMIN_ADDRESS in the constructor.
# Can be the deployer wallet on testnet; use a multisig on mainnet.
ADMIN_ADDRESS=0xYourAdminWalletAddress

# The deploy script grants MINTER_ROLE to MINTER_ADDRESS in the constructor.
# This is the server's signing wallet — address only, NOT the private key.
# The private key for this wallet lives in Supabase secrets (testnet) or
# AWS/GCP KMS (mainnet). See docs/KIJONSAI-CONTRACT-ARCH.md §9.1.
MINTER_ADDRESS=0xYourServerMinterWalletAddress

# ── RPC endpoints ─────────────────────────────────────────────────────────────
# Defaults are public endpoints — fine for testnet/dev.
# For mainnet, use a dedicated endpoint (Ankr, dRPC, or run your own node).
RONIN_RPC_URL=https://saigon-testnet.roninchain.com/rpc
RONIN_MAINNET_RPC_URL=https://api.roninchain.com/rpc

# ── No ETHERSCAN_API_KEY ──────────────────────────────────────────────────────
# Ronin uses Sourcify (https://sourcify.roninchain.com), not Etherscan.
# Verification is handled automatically by deploy/99_verify.ts.
