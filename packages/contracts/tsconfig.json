  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "./hardhat.config.ts",
    "./deploy/**/*.ts",
    "./test/**/*.ts",
    "./typechain-types/**/*.ts"
  ]
}
