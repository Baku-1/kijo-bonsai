# Kijo Web — local environment overrides (gitignored)

# Waypoint connector — optional; only the roninWallet() connector loads when empty.
# Get a client ID from: https://developers.roninchain.com/console/applications/
VITE_WAYPOINT_CLIENT_ID=

# Treasury wallet address for seed purchases (RON payments sent here).
# Replace before testnet testing. Defaults to placeholder in useSeedPurchase.ts.
VITE_TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS

# EIP-712 domain -- contract address for Kijonsai ERC-721 (testnet).
# Update to mainnet address when mainnet deploys.
VITE_KIJONSAI_CONTRACT_ADDRESS=0x4447F631F5868bFA03A6e6ae2D2da9f22c787E44

# Ronin chain ID. 202601 = Saigon testnet. Set to 2020 for mainnet.
VITE_RONIN_CHAIN_ID=202601

# Supabase anon key (public -- safe for frontend). Used by token refresh (A7-2).
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh1dGp1Ymthc2t3Y2h6eXp3cnlrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ2MDYwNDIsImV4cCI6MjEwMDE4MjA0Mn0.3Ph_N368COgg4iupEHvyhZMZX1XC1eu0p69Am8l7eUw
